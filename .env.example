# BLUE COURT blog automation settings.
# Copy to .env and fill it in yourself. .env is git-ignored; never commit it.
# Nothing here is required: with an empty .env the daily text article is still
# published, only without a photo and without pushing to GitHub.

# --- Google Drive photos ---------------------------------------------------
# Folder ID or the pasted folder URL. Share the folder with the service account
# address (…@….iam.gserviceaccount.com) as Viewer.
GDRIVE_FOLDER_ID=
# Put the service account JSON at ./secrets/google-service-account.json.
# The container reads it at /secrets/google-service-account.json (compose sets
# GOOGLE_APPLICATION_CREDENTIALS for you); do not paste the key itself here.

# Alt text written for accessibility, and an optional credit line shown under
# the photo. The app never invents a description of a photo.
PHOTO_ALT=BLUE COURT編集部が用意した横浜のサッカー写真
PHOTO_CREDIT=
PHOTO_WIDTH=1600
PHOTO_HEIGHT=900
PHOTO_QUALITY=82
# 1: reuse the oldest photo once every photo has been published. 0: stop adding
# photos instead of repeating one.
PHOTO_REUSE=1

# --- container user --------------------------------------------------------
# Files are generated into the mounted repository. Keep these equal to the host
# account that owns the checkout (`id -u` / `id -g`), or the new articles end up
# owned by root and the next local edit or git command fails.
HOST_UID=1000
HOST_GID=1000

# --- publishing ------------------------------------------------------------
# JST wall clock of the daily run.
PUBLISH_AT=10:10
# 1: also publish immediately when the scheduler container starts.
RUN_AT_START=1

# --- local preview ---------------------------------------------------------
# Host port for `docker compose up -d preview`.
PREVIEW_PORT=8099

# --- git push (off by default) ---------------------------------------------
# 1 makes the container commit and push. It needs the push key inside the
# container: SSH_DIR is mounted read-only at /ssh and SSH_KEY_FILE names the
# key within it. The key must already be registered on GitHub.
GIT_PUSH=0
SSH_DIR=/home/ubuntu/.ssh
SSH_KEY_FILE=id_ed25519_github
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_AUTHOR_NAME=blue-court-bot
GIT_AUTHOR_EMAIL=bot@users.noreply.github.com

# --- 記事の執筆（LLM / OpenAI） -------------------------------------------
# キーの値は利用者本人が記入する。未設定でも動く（手書き24本のローテーション）。
# 設定すると、その日の記事をOpenAIが書く。禁止表現が出た場合は自動で破棄して
# ローテーションに戻るので、ブログが止まることはない。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=2000

# --- 公開URL ---------------------------------------------------------------
# canonical・og:url・sitemap・記事URLがここから作られる。独自ドメインに移すときは
# この1行を変える（末尾のスラッシュは任意、無ければ補われる）。
# 公開ファイルの置き場所。nginxで配る場合は /var/www/blue-court にする。
SITE_PUBLIC_DIR=./site
SITE_BASE_URL=https://blue-court-yscc.onrender.com/
