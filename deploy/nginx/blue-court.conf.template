# BLUE COURT（静的サイト）. deploy/setup_nginx.sh が __DOMAIN__ と __ROOT__ を置換して
# /etc/nginx/sites-available/ に置く。TLSの行は certbot --nginx が後から追記する。
#
# 既存サイト（joeai.co.jp 等）の作法に合わせている:
#   - 遮断は 404 を返し blocked.log に記録する（捨てると fail2ban が相手を見つけられない）
#   - 隠しファイルと置き忘れファイルを web から取らせない
# このサイトはPHPを使わない静的配信なので、WordPress向けの保護は入れていない。
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __ROOT__;
    index index.html;

    access_log /var/log/nginx/blue-court.access.log;
    error_log  /var/log/nginx/blue-court.error.log;

    add_header X-Frame-Options        "SAMEORIGIN"                      always;
    add_header X-Content-Type-Options "nosniff"                         always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # .env や .git を web から取らせない。公開ディレクトリは許可リストで作っているので
    # 本来入っていないが、設定ミスの保険として二重にしておく（certbot の .well-known は通す）。
    location ~ /\.(?!well-known) { access_log /var/log/nginx/blocked.log; return 404; }
    location ~* \.(bak|old|orig|save|swp|swo|sql|tar|tgz|zip|log|py|yml|yaml|json\.bak)$ {
        access_log /var/log/nginx/blocked.log; return 404;
    }

    # 記事とJSONは毎日入れ替わるので短め、CSS/JS/画像は長めに持たせる。
    location = /data/posts.json   { expires 5m; add_header Cache-Control "public, max-age=300"; }
    location = /data/matches.json { expires 5m; add_header Cache-Control "public, max-age=300"; }
    location ~* \.(css|js|svg|jpg|jpeg|png|webp|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # 管理画面（docker compose の admin サービス、127.0.0.1:8102）。
    # ^~ にするのは、上の正規表現 location（.css/.js の長期キャッシュ・隠しファイル遮断）に
    # 管理画面のURLを取られないため。取られると admin.css が404になり、画面が崩れる。
    # X-Forwarded-For は追記せず $remote_addr で上書きする（アプリは1段だけ信用する。
    # 追記にすると、利用者が送った偽のIPでログイン回数制限をすり抜けられる）。
    # セキュリティ系ヘッダーはアプリが付ける（ここで add_header を書くと server の
    # add_header が継承されなくなる）。
    location ^~ /admin/ {
        proxy_pass http://127.0.0.1:8102;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;   # 公開ボタン（書き出し＋push）とAIの書き直しを待つ
        client_max_body_size 1m;
        access_log /var/log/nginx/blue-court-admin.access.log;
        # server の add_header（X-Frame-Options 等）とアプリのヘッダーが二重になり、値が食い違う
        # ため、アプリ側の同名ヘッダーを落として server の値に揃える。枠埋め込みの禁止は
        # アプリの CSP（frame-ancestors 'none'）が効く。
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
